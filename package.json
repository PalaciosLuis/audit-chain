{
  "name": "audit-chain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive explainer: tamper-evident audit logs. A real SHA-256 hash chain, Merkle tree, root anchoring and ECDSA-signed export run in the browser with Web Crypto. No server, ever.",
  "license": "MIT",
  "author": "Luis Palacios",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "budget": "node scripts/check-budget.mjs",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
